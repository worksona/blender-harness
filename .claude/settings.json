{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/session-start.sh",
            "timeout": 900
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(scripts/bl:*)",
      "Bash(scripts/setup.sh:*)",
      "Bash(make:*)",
      "Bash(python3 tools/new_world.py:*)",
      "Bash(python3 tools/manifest.py)"
    ]
  }
}
